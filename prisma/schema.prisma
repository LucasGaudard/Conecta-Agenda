generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PROFESSIONAL)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business            Business?
  subscription        Subscription?
  blockedBusinesses   Business[]           @relation("BusinessBlockedBy")
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model Business {
  id                  String    @id @default(cuid())
  userId              String    @unique
  name                String
  slug                String    @unique
  description         String?
  whatsapp            String?
  city                String?
  address             String?
  instagram           String?
  logoUrl             String?
  primaryColor        String?
  isManuallyBlocked   Boolean   @default(false)
  blockReason         String?
  blockedAt           DateTime?
  blockedByUserId     String?
  accessOverrideUntil DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockedBy     User?             @relation("BusinessBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)
  settings      BusinessSettings?
  services      Service[]
  customers     Customer[]
  appointments  Appointment[]
  workingHours  WorkingHour[]
  blockedTimes  BlockedTime[]
  notifications Notification[]

  @@index([blockedByUserId])
}

model BusinessSettings {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  timezone               String   @default("America/Sao_Paulo")
  currency               String   @default("BRL")
  bookingIntervalMinutes Int      @default(30)
  allowCancellation      Boolean  @default(true)
  allowReschedule        Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  priceInCents Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  providerPlans ProviderPlan[]
}

model Subscription {
  id                     String              @id @default(cuid())
  userId                 String              @unique
  planId                 String
  status                 SubscriptionStatus
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  provider               BillingProvider?
  providerEnvironment    BillingEnvironment?
  providerSubscriptionId String?
  providerStatus         String?
  externalReference      String?             @unique
  nextPaymentAt          DateTime?
  cancelRequestedAt      DateTime?
  canceledAt             DateTime?
  lastProviderSyncAt     DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan                     @relation(fields: [planId], references: [id])
  checkoutAttempts BillingCheckoutAttempt[]
  billingEvents    BillingEvent[]
  billingPayments  BillingPayment[]

  @@unique([provider, providerEnvironment, providerSubscriptionId], map: "Subscription_provider_providerEnvironment_providerSubscriptionI")
  @@index([planId])
  @@index([status, currentPeriodEnd])
}

model ProviderPlan {
  id             String             @id @default(cuid())
  planId         String
  provider       BillingProvider
  environment    BillingEnvironment
  providerPlanId String
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, provider, environment])
  @@unique([provider, environment, providerPlanId])
  @@index([provider, environment, isActive])
}

model BillingCheckoutAttempt {
  id                     String                @id @default(cuid())
  subscriptionId         String
  provider               BillingProvider
  environment            BillingEnvironment
  idempotencyKey         String                @unique
  externalReference      String                @unique
  providerSubscriptionId String?
  status                 BillingCheckoutStatus @default(CREATED)
  expiresAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([provider, environment, providerSubscriptionId], map: "BillingCheckoutAttempt_provider_environment_providerSubscriptio")
  @@index([status, expiresAt])
}

model BillingEvent {
  id               String             @id @default(cuid())
  subscriptionId   String?
  provider         BillingProvider
  environment      BillingEnvironment
  deduplicationKey String             @unique
  providerEventId  String
  requestId        String?
  topic            String
  action           String?
  resourceId       String
  payloadHash      String?
  status           BillingEventStatus @default(RECEIVED)
  attempts         Int                @default(0)
  errorCode        String?
  receivedAt       DateTime           @default(now())
  processedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, environment, topic, providerEventId])
  @@index([subscriptionId, receivedAt])
  @@index([status, receivedAt])
  @@index([provider, environment, resourceId])
}

model BillingPayment {
  id                          String               @id @default(cuid())
  subscriptionId              String
  provider                    BillingProvider
  environment                 BillingEnvironment
  providerPaymentId           String
  providerAuthorizedPaymentId String?
  status                      BillingPaymentStatus
  providerStatus              String
  statusDetail                String?
  amountInCents               Int
  currency                    String               @default("BRL")
  paidAt                      DateTime?
  providerCreatedAt           DateTime?
  providerUpdatedAt           DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, environment, providerPaymentId])
  @@index([subscriptionId, status])
  @@index([provider, environment, providerAuthorizedPaymentId], map: "BillingPayment_provider_environment_providerAuthorizedPaymentId")
  @@index([status, providerUpdatedAt])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  priceInCents    Int
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  whatsapp   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId, whatsapp])
}

model WorkingHour {
  id         String    @id @default(cuid())
  businessId String
  dayOfWeek  DayOfWeek
  startTime  String?
  endTime    String?
  breakStart String?
  breakEnd   String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Appointment {
  id              String            @id @default(cuid())
  businessId      String
  customerId      String
  serviceId       String?
  serviceName     String
  priceInCents    Int
  durationMinutes Int
  date            DateTime          @db.Date
  startTime       String
  endTime         String
  status          AppointmentStatus
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([businessId, date])
  @@index([customerId])
  @@index([serviceId])
}

model BlockedTime {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime @db.Date
  startTime  String
  endTime    String
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}

model Notification {
  id            String              @id @default(cuid())
  businessId    String
  appointmentId String?
  type          NotificationType
  channel       NotificationChannel
  status        NotificationStatus
  scheduledAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([appointmentId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingProvider {
  MERCADO_PAGO
}

enum BillingEnvironment {
  TEST
  PRODUCTION
}

enum BillingCheckoutStatus {
  CREATED
  PROVIDER_CREATED
  COMPLETED
  FAILED
  EXPIRED
}

enum BillingEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum BillingPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
  CHARGED_BACK
  UNKNOWN
}

enum UserRole {
  PROFESSIONAL
  SUPER_ADMIN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLATION
  APPOINTMENT_RESCHEDULE
}

enum NotificationChannel {
  WHATSAPP_MANUAL
  EMAIL
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}
