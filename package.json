{
  "name": "conecta-agenda",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @conecta-agenda/api --filter @conecta-agenda/web dev",
    "dev:api": "pnpm --filter @conecta-agenda/api dev",
    "dev:web": "pnpm --filter @conecta-agenda/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && eslint prisma",
    "format": "prettier . --write",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:admin:create": "tsx prisma/create-admin.ts",
    "test": "tsx --test apps/api/src/domain/business-access.test.ts apps/api/src/routes/business-access.test.ts apps/api/src/billing/billing.test.ts apps/api/src/billing/policy.test.ts apps/api/src/billing/mercado-pago-http.test.ts apps/api/src/billing/subscription-preparation.test.ts apps/api/src/password-reset/password-reset.test.ts apps/api/src/load-env.test.ts prisma/provisioning.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
