# API dev: usar .env.development.local.example; este exemplo mantém configurações gerais/legadas.
NODE_ENV=development
API_PORT=3333
HOST=0.0.0.0
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="change-me-in-development-use-at-least-32-chars-in-production"
FRONTEND_URL="http://localhost:3001"

# Admin create-only; password >=12 chars, upper/lowercase, digit, symbol; <=72 UTF-8 bytes.
SUPER_ADMIN_NAME=""
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

PAYMENT_GRACE_PERIOD_DAYS=3
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Optional billing configuration; never commit real credentials.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=TEST
BILLING_CHECKOUT_MODE=OFF
MERCADO_PAGO_APPLICATION_ID=
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_BACK_URL=http://localhost:3000/settings/billing

# HTTP preparation only: simulated transport, no checkout or network enabled by env.
# No fallback to generic or PRODUCTION credentials. Token prefix does not prove scope.
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_TEST_APPLICATION_ID=
MERCADO_PAGO_TEST_COLLECTOR_ID=
MERCADO_PAGO_TEST_BACK_URL=https://example.invalid/settings/billing
MERCADO_PAGO_TEST_TIMEOUT_MS=5000
# Reserved for a future, separately authorized production adapter; unused here.
MERCADO_PAGO_PRODUCTION_ACCESS_TOKEN=
MERCADO_PAGO_PRODUCTION_APPLICATION_ID=
MERCADO_PAGO_PRODUCTION_COLLECTOR_ID=
MERCADO_PAGO_PRODUCTION_BACK_URL=

# Demo seed only on disposable development databases; explicit opt-in.
ALLOW_DEMO_SEED=false
